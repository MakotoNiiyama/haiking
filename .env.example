# ── AI バックエンド (どちらか片方を設定) ──────────────────────────────────────
#
# [ローカル開発推奨] Azure OpenAI
#   AZURE_OPENAI_API_KEY が設定されている場合、自動的に AOAI を使用する
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.azure-api.net/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-04-01-preview
#
# [本番推奨] AWS Bedrock (Claude Haiku 4.5)
#   AOAI が未設定の場合に自動使用。Amplify では IAM ロールで認証。
#   モデルを変えたい場合のみ設定（デフォルト: claude-haiku-4.5）
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0

# ── AWS S3 (画像ストレージ) ────────────────────────────────────────────────────
# IAM ユーザーのアクセスキー（S3 書き込み権限のみ付与すること）
# ※ Amplify は AWS_ プレフィックスを予約済みのため S3_ を使用
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=your-bucket-name

# ── CloudFront (CDN) ───────────────────────────────────────────────────────────
# CloudFront ディストリビューションのドメイン（https:// なし）
NEXT_PUBLIC_CDN_DOMAIN=xxxxxxxxxxxxxx.cloudfront.net
