# ── AWS Bedrock (AI 生成) ──────────────────────────────────────────────────────
# モデルIDを省略すると Claude Haiku 4.5 がデフォルトで使用される
# BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
# ローカル実行時は ~/.aws/credentials の認証情報が使われる
# 本番(Amplify)では IAM サービスロールの権限で自動認証される

# ── AWS S3 (画像ストレージ) ────────────────────────────────────────────────────
# IAM ユーザーのアクセスキー（S3 書き込み権限のみ付与すること）
# ※ Amplify は AWS_ プレフィックスを予約済みのため S3_ を使用
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_REGION=ap-northeast-1
S3_BUCKET_NAME=your-bucket-name

# ── CloudFront (CDN) ───────────────────────────────────────────────────────────
# CloudFront ディストリビューションのドメイン（https:// なし）
NEXT_PUBLIC_CDN_DOMAIN=xxxxxxxxxxxxxx.cloudfront.net
